# 서버 포트 (선택)
PORT=5172
# 사용할 모델 별칭 (선택, 예: opus). 비우면 claude CLI 기본 모델
CLAUDE_MODEL=
# 이미지 API 키 (선택). 설정 화면에서도 넣을 수 있고, 여기 값이 있으면 우선한다.
# 키가 있으면 Gemini/ChatGPT 이미지를 API로 만들고, 없거나 한도·잔액이 부족하면 크롬(Claude in Chrome)에서 만든다.
GEMINI_API_KEY=
OPENAI_API_KEY=
# 이미지 모델 (선택). 비우면 gemini-2.5-flash-image / gpt-image-2.5-flare
GEMINI_IMAGE_MODEL=
OPENAI_IMAGE_MODEL=

# 네이버 검색광고 API 키 (키워드 탐색의 월간 검색량). 설정 화면에서 넣어도 됩니다.
SEARCHAD_CUSTOMER_ID=
SEARCHAD_API_KEY=
SEARCHAD_SECRET_KEY=
